{
  "name": "@durafoundry/git-activities",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "pretypecheck": "npm run build --workspace @durafoundry/artifact-store && npm run build --workspace @durafoundry/fixture-repo",
    "typecheck": "tsc --noEmit",
    "prebuild": "npm run build --workspace @durafoundry/artifact-store",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test \"dist/**/*.test.js\""
  },
  "dependencies": {
    "@durafoundry/artifact-store": "0.0.0",
    "@durafoundry/domain": "0.0.0"
  },
  "devDependencies": {
    "@durafoundry/fixture-repo": "0.0.0",
    "@types/node": "^20.19.0"
  }
}
