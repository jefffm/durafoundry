{
  "name": "@durafoundry/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "durafoundry": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "pretypecheck": "npm run build --workspace @durafoundry/workflows",
    "typecheck": "tsc --noEmit",
    "prebuild": "npm run build --workspace @durafoundry/workflows",
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "npm run build && node --test \"dist/**/*.test.js\""
  },
  "dependencies": {
    "@durafoundry/fake-agent-activities": "0.0.0",
    "@durafoundry/fixture-repo": "0.0.0",
    "@durafoundry/git-activities": "0.0.0",
    "@durafoundry/workflows": "0.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0"
  }
}
